# Template for ~/.aws/credentials with profiles for AWS, Cloudflare R2,
# and RunPod's S3-compatible storage. Copy to ~/.aws/credentials and
# fill in real values.
#
# Use with the AWS CLI by specifying --profile <name>:
#   aws --profile cloudflare-r2 --endpoint-url $CLOUDFLARE_R2_ENDPOINT \
#       --region auto s3 ls s3://your-r2-bucket/
#   aws --profile runpod-us-ks-2 --endpoint-url $RUNPOD_S3_ENDPOINT \
#       s3 ls s3://your-runpod-bucket/

[default]
# Real AWS credentials — leave blank if you don't use AWS
aws_access_key_id =
aws_secret_access_key =

[cloudflare-r2]
# Cloudflare R2 access key from R2 dashboard → Manage R2 API Tokens
aws_access_key_id = <your_r2_access_key_id>
aws_secret_access_key = <your_r2_secret_access_key>

[runpod-us-ks-2]
# RunPod S3-compatible storage credentials (per-region)
aws_access_key_id = <your_runpod_s3_access_key>
aws_secret_access_key = <your_runpod_s3_secret_key>
