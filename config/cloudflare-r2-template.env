# Template for Cloudflare R2 credentials.
# Copy this to /data/.env.cloudflare (or another location of your choice)
# on your pod, fill in real values, then point CLOUDFLARE_R2_ENDPOINT
# at your account. Source this file before running R2-related tools.
#
# WHY USE CLOUDFLARE_R2_* PREFIX (not AWS_*):
# Cloudflare R2 is S3-compatible, but if you set AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY in the environment, the AWS CLI will pick those
# up for ALL operations — including any AWS S3 calls — and treat them
# as your real AWS credentials, which can cause cross-account confusion
# or accidental writes to the wrong account. Using CLOUDFLARE_R2_*
# prefixed env vars avoids that collision: scripts read them and pass
# them explicitly to boto3 / the AWS CLI's --profile flag, never via
# the shared AWS_* env var slot.

# Cloudflare account ID (32-char hex string from the R2 dashboard URL)
export CLOUDFLARE_ACCOUNT_ID="<your_account_id>"

# R2 endpoint URL — derived from account ID
export CLOUDFLARE_R2_ENDPOINT="https://${CLOUDFLARE_ACCOUNT_ID}.r2.cloudflarestorage.com"

# R2 access key (created in R2 dashboard → Manage R2 API Tokens)
export CLOUDFLARE_R2_ACCESS_KEY_ID="<your_r2_access_key_id>"
export CLOUDFLARE_R2_SECRET_ACCESS_KEY="<your_r2_secret_access_key>"
